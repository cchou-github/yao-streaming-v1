# Real-AWS deployment manifest TEMPLATE. Genuinely separate from
# ../mysql.yaml, ../localstack.yaml, ../app.yaml (the kind-oriented set)
# rather than templated with Kustomize/Helm - the structures actually
# differ (no mysql/localstack sidecars to depend on here at all), and
# this matches the project's existing no-templating-tooling convention.
#
# This file itself is never applied directly and never holds real
# values - k8s/aws/deploy.sh copies it to app.yaml (gitignored) on
# every run, then patches that copy with real `terraform output` values,
# the same .example-file pattern as terraform/terraform.tfvars.example.
#
# Most values (bucket names, IRSA role ARN, ECR image URL) are
# deterministic and stay correct across a `terraform destroy` + `apply`
# cycle, and are baked into this template directly. DB_HOST and
# CLOUDFRONT_DOMAIN_NAME/KEY_PAIR_ID are the exceptions - a new RDS
# instance gets a new AWS-assigned endpoint even with the same identifier,
# and a new distribution gets a new domain and key pair - and stay as the
# obviously-fake `pending-terraform-apply...` placeholders below;
# deploy.sh patches all three on every run.
#
# NOT included here: the app-secret Secret. Unlike the kind manifests,
# DB_PASSWORD and CLOUDFRONT_PRIVATE_KEY here are real, live secrets (an
# RDS master password and a CloudFront cookie-signing key) - neither must
# ever be baked into a committed file. Create it imperatively instead:
#   kubectl create secret generic app-secret \
#     --from-literal=DB_PASSWORD="$(terraform output -raw rds_master_password)" \
#     --from-literal=CLOUDFRONT_PRIVATE_KEY="$(terraform output -raw cloudfront_playback_private_key_pem)"
# (run from terraform/, before applying this file - the Deployment below
# references app-secret via secretRef and expects it to already exist.
# k8s/aws/deploy.sh already does this for you on every run.)

apiVersion: v1
kind: ConfigMap
metadata:
  name: app-config
data:
  DB_HOST: pending-terraform-apply.rds.amazonaws.com
  DB_PORT: "3306"
  DB_NAME: streaming
  DB_USER: streaming_admin
  RAW_BUCKET: yao-streaming-raw-720289141862
  PROCESSED_BUCKET: yao-streaming-processed-720289141862
  AWS_REGION: ap-northeast-1
  # AWS_ENDPOINT_URL / AWS_PUBLIC_ENDPOINT_URL deliberately omitted - see
  # S3Config.java: unset means the SDK talks to real AWS S3 directly,
  # rather than a LocalStack override.
  # LocalUploadWatcher (the local ffmpeg-polling pipeline) must stay off
  # here - it races the real S3-triggered Lambda/MediaConvert pipeline for
  # every upload and reliably wins (local DB polling is much faster than a
  # real MediaConvert job), claiming and failing videos before MediaConvert
  # ever finishes. See LocalUploadWatcher.java's javadoc.
  TRANSCODE_WATCHER_ENABLED: "false"
  # CLOUDFRONT_DOMAIN_NAME/KEY_PAIR_ID come from `terraform output`, same as
  # everything else here, but - unlike the bucket names/IRSA ARN - neither
  # is stable across a destroy+apply cycle: a new distribution gets a new
  # domain and a new key pair. deploy.sh patches both here on every run,
  # the same way it already patches DB_HOST - the values below are only
  # ever placeholders, never meant to stay committed as real values.
  CLOUDFRONT_ENABLED: "true"
  CLOUDFRONT_DOMAIN_NAME: pending-terraform-apply.cloudfront.net
  CLOUDFRONT_KEY_PAIR_ID: pending-terraform-apply

---
# IRSA: replaces the kind manifests' static AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY entirely (not just changes their values). The AWS
# SDK's default credential chain picks this role up automatically once a
# pod uses this ServiceAccount.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: yao-streaming-app
  annotations:
    eks.amazonaws.com/role-arn: arn:aws:iam::720289141862:role/yao-streaming-app-irsa-role

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app
spec:
  # Cost-down for the first real deployment - see k8s/app.yaml (the kind
  # version) for why 2 is safe whenever it's needed again; nothing about
  # that changed, this is purely a cost choice for now.
  replicas: 1
  selector:
    matchLabels:
      app: app
  template:
    metadata:
      labels:
        app: app
    spec:
      serviceAccountName: yao-streaming-app
      # Same idea as the kind manifests' wait-for-mysql initContainer,
      # pointed at the real RDS endpoint instead of the "mysql" k8s DNS
      # name (nothing here provides that name - RDS isn't a pod).
      initContainers:
        - name: wait-for-rds
          image: busybox:1.36
          command:
            - sh
            - -c
            - until nc -z pending-terraform-apply.rds.amazonaws.com 3306; do echo waiting for rds; sleep 2; done
      containers:
        - name: app
          image: 720289141862.dkr.ecr.ap-northeast-1.amazonaws.com/yao-streaming-app:latest
          # Always, not IfNotPresent: the tag is mutable (always "latest"),
          # so IfNotPresent would keep reusing whatever image content a
          # node already cached under that tag string, silently ignoring
          # a freshly pushed image with the same tag. Caught for real:
          # a redeploy ran successfully but the pod kept serving code
          # from the very first push, hours earlier.
          imagePullPolicy: Always
          ports:
            - containerPort: 8080
          envFrom:
            - configMapRef:
                name: app-config
            - secretRef:
                name: app-secret
          readinessProbe:
            httpGet:
              path: /actuator/health
              port: 8080
            initialDelaySeconds: 20
            periodSeconds: 5
            timeoutSeconds: 5
            failureThreshold: 10
          livenessProbe:
            httpGet:
              path: /actuator/health
              port: 8080
            initialDelaySeconds: 40
            periodSeconds: 10

---
# NodePort, not ClusterIP: terraform/alb.tf's target group routes to this
# fixed port on each node. Fixed rather than auto-assigned so Terraform
# knows exactly where to send traffic, without discovering a port value
# across the Terraform/kubectl boundary. kubectl port-forward svc/app
# still works the same as before this change.
apiVersion: v1
kind: Service
metadata:
  name: app
spec:
  type: NodePort
  selector:
    app: app
  ports:
    - port: 8080
      targetPort: 8080
      nodePort: 30080
